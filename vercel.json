{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "if [ -f deploy/vercel-build.mjs ]; then npm ci --no-audit --no-fund; else npm ci --prefix .. --no-audit --no-fund; fi",
  "buildCommand": "if [ -f deploy/vercel-build.mjs ]; then node deploy/vercel-build.mjs; else node ../deploy/vercel-build.mjs; fi",
  "outputDirectory": "site",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/twin", "destination": "/" },
    { "source": "/farm", "destination": "/" },
    { "source": "/cow-flow", "destination": "/journey" },
    { "source": "/gauri", "destination": "/journey" },
    { "source": "/documentation", "destination": "/docs" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/src/assets/(og|icon).png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
